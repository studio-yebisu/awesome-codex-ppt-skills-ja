  "presets": [
    {
      "id": "editorial",
      "title": "誌面とブランド",
      "heading": "Shippori Mincho",
      "body": "Zen Kaku Gothic New",
      "latin": "Manrope",
      "instruction": "アイボリーと墨黒を基調に、赤橙を一点。明朝の大見出しと短い本文、大きな余白、縦横のグリッドで誌面を作る。"
    },
    {
      "id": "motion",
      "title": "夜とモーション",
      "heading": "Zen Kaku Gothic New",
      "body": "Zen Kaku Gothic New",
      "latin": "Space Grotesk",
      "instruction": "墨紺に蛍光ライム。短い見出しを大きく置き、SVG図形と段階表示で視線を導く。動きは220〜450ms、ページごとに一つの主張。"
    },
    {
      "id": "friendly",
      "title": "やさしい教材",
      "heading": "Zen Maru Gothic",
      "body": "Zen Kaku Gothic New",
      "latin": "Manrope",
      "instruction": "丸ゴシックは見出しに、端正なゴシックは本文に。図解と余白を優先し、読み手が次にすることを一つずつ伝える。"
    },
    {
      "id": "poster",
      "title": "強い表紙",
      "heading": "Dela Gothic One",
      "body": "Zen Kaku Gothic New",
      "latin": "Space Grotesk",
      "instruction": "Delaは短い見出しのみ。大胆な一色と大きな文字・図形で表紙を作る。本文に太い装飾書体を使わず、ページで構図を変える。"
    },
    {
      "id": "work",
      "title": "業務と数字",
      "heading": "BIZ UDPGothic",
      "body": "BIZ UDPGothic",
      "latin": "Manrope",
      "instruction": "BIZ UDPGothicの太字で結論、標準ウェイトで説明を組む。数字の単位と比較対象を明記し、表は罫線を減らして列を揃える。白地と墨紺に赤橙を一点。見出しを大きく、本文は短い段落にする。"
    },
    {
      "id": "explain",
      "title": "説明と教材",
      "heading": "BIZ UDPMincho",
      "body": "BIZ UDPGothic",
      "latin": "Manrope",
      "instruction": "BIZ UDPMinchoの太字で題名、BIZ UDPGothicで説明と図のラベルを組む。紙色と深緑を基調に、赤橙は注目する量だけに使う。式・図・説明を対応させ、学習用の設定と実測値を区別する。"
    },
    {
      "id": "research",
      "title": "研究と図表",
      "heading": "Noto Sans CJK JP",
      "body": "Noto Sans CJK JP",
      "latin": "Manrope",
      "instruction": "Noto Sans CJK JPの太字で主張、標準ウェイトで図のラベルと説明を組む。白地と墨紺を基調に、青は比較する系列だけに使う。図・式・出典を近くに置き、単位と仮定を明記する。Noto Sans JPとNoto Sans CJK JPはフォント名が異なるため、原稿とPPTXに指定した名前を揃える。"
    },
    {
      "id": "technical",
      "title": "コードと技術発表",
      "heading": "BIZ UDPMincho",
      "body": "BIZ UDPGothic",
      "latin": "Manrope",
      "code": "JetBrains Mono",
      "instruction": "明朝の短い主張、ゴシックの日本語説明、JetBrains Monoのコードと変数を使い分ける。白地と青を基調に、コード・図・実行結果を順に見せる。コードは重要な数行に絞り、字幅を揃える。合字で演算子を省略せず、読み上げる記号を見せる。JetBrains Monoには日本語を任せず、コード内の日本語コメントにはBIZ UDPGothicをフォールバックする。学習用データと実測値を区別し、実行していないコードを結果として扱わない。"
    }
  ]
}
