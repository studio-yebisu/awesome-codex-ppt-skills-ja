  "presets": [
    {
      "id": "editorial",
      "title": "誌面とブランド",
      "heading": "Shippori Mincho",
      "body": "Zen Kaku Gothic New",
      "latin": "Manrope",
      "instruction": "アイボリーと墨黒を基調に、赤橙を一点。明朝の大見出しと短い本文、大きな余白、縦横のグリッドで誌面を作る。"
    },
    {
      "id": "motion",
      "title": "夜とモーション",
      "heading": "Zen Kaku Gothic New",
      "body": "Zen Kaku Gothic New",
      "latin": "Space Grotesk",
      "instruction": "墨紺に蛍光ライム。短い見出しを大きく置き、SVG図形と段階表示で視線を導く。動きは220〜450ms、ページごとに一つの主張。"
    },
    {
      "id": "friendly",
      "title": "やさしい教材",
      "heading": "Zen Maru Gothic",
      "body": "Zen Kaku Gothic New",
      "latin": "Manrope",
      "instruction": "丸ゴシックは見出しに、端正なゴシックは本文に。図解と余白を優先し、読み手が次にすることを一つずつ伝える。"
    },
    {
      "id": "poster",
      "title": "強い表紙",
      "heading": "Dela Gothic One",
      "body": "Zen Kaku Gothic New",
      "latin": "Space Grotesk",
      "instruction": "Delaは短い見出しのみ。大胆な一色と大きな文字・図形で表紙を作る。本文に太い装飾書体を使わず、ページで構図を変える。"
    }
  ]
