[
  {
    "case_id": "and-scene-showcase",
    "guide_patch": {
      "requirements": [
        "Node.jsとnpm（作例実行はNode24.18.0/npm11.16.0）、app/package-lock.jsonの固定依存",
        "検査はPython3とChrome/Chromium、distのHTTP配信"
      ],
      "commands": [
        "cd app && npm ci",
        "cd app && npm run build",
        "python -m http.server 8000 --bind 127.0.0.1 --directory dist"
      ]
    }
  },
