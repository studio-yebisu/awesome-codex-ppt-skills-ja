            "y": 648.234375,
            "w": 420,
            "h": 66.140625
          }
        },
        {
          "text": "会場でひと息。\n空を見る時間をつくる。",
          "box": {
            "x": 750,
            "y": 739.375,
            "w": 420,
            "h": 108
          }
