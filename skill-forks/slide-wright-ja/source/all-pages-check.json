      "index": 1,
      "title": "みんなで、夜を見上げる。",
      "notes": "過ごし方の提案です。特定の天体が見えることや観測成果を約束しません。会場の導線・安全条件は未定です。",
      "fonts": "loaded",
      "section": {
        "x": 0,
        "y": 0,
        "w": 1920,
        "h": 1080
      },
      "text": [
        {
          "text": "急がず、\n過ごす。",
          "box": {
            "x": 195,
            "y": 535,
            "w": 420,
            "h": 163.1875
          }
        },
        {
          "text": "AT THE VENUE",
          "box": {
            "x": 140,
            "y": 145,
            "w": 1640,
            "h": 43.1875
          }
        },
        {
          "text": "みんなで、夜を見上げる。",
          "box": {
            "x": 140,
            "y": 233.1875,
            "w": 1640,
            "h": 112.046875
          }
        },
        {
          "text": "案内を聞く",
          "box": {
            "x": 840,
            "y": 425.234375,
            "w": 940,
            "h": 62.09375
          }
        },
        {
          "text": "会場での過ごし方を、最初に共有。",
          "box": {
            "x": 840,
            "y": 497.328125,
            "w": 940,
            "h": 55.796875
          }
        },
        {
          "text": "静かに待つ",
          "box": {
            "x": 840,
            "y": 595.125,
            "w": 940,
            "h": 62.09375
          }
        },
        {
          "text": "眺めたい場所で、ゆっくり過ごす。",
          "box": {
            "x": 840,
            "y": 667.21875,
            "w": 940,
            "h": 55.796875
          }
