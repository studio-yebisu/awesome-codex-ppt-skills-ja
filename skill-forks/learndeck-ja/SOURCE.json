  "original_cli_executed": "runtime/scripts/html_to_ppt.js --input source.html --out-dir . --name deck --no-preview --font-face \"BIZ UDPGothic\" --viewport-width 1280 --viewport-height 720",
  "modifications": [
    "Local converter only: collect computed fontFamily for elements/text runs and use its first family instead of forcing every run to one font.",
    "Local converter language metadata changed zh-CN to ja-JP.",
    "SVG export local repair: persist actual DOM viewport width/height before sharp rasterization so preserveAspectRatio letterboxing survives PPTX placement. Original DOM measurement, native reconstruction and gradient patch pipeline retained."
  ],
  "editability": {
    "text": "Native editable text boxes with Dela/Shippori/BIZ roles.",
    "shapes": "Native background, bar, ellipse, vase, shelf and divider shapes.",
    "flowers": "Separate PNG image objects from SVG; SVG sources retained. Petals are not native editable PowerPoint shapes."
  },
