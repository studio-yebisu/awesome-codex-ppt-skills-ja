{
  "schema_version": "1.1",
  "canvas": "16:9 fixed stage",
  "allow_custom_layouts": true,
  "topologies": [
    {
      "id": "stage",
      "encodes": "one dominant message or object",
      "reading_flow": "single focal entry, then support",
      "use_for": ["cover", "statement", "closing", "hero media"],
      "avoid_when": "the audience must compare several peers"
    },
    {
      "id": "split",
      "encodes": "claim-to-proof, before-to-after, or two-sided contrast",
      "reading_flow": "left-to-right or problem-to-resolution",
      "use_for": ["claim and evidence", "case study", "comparison"],
      "avoid_when": "more than two peer groups need equal attention"
    },
    {
      "id": "spine",
      "encodes": "ordered sequence, progression, or milestones",
      "reading_flow": "along one explicit axis",
      "use_for": ["process", "timeline", "roadmap", "journey"],
      "avoid_when": "relationships are non-linear"
    },
    {
      "id": "axis",
      "encodes": "quantitative position, trend, rank, or variance",
      "reading_flow": "claim to scale to highlighted evidence",
      "use_for": ["chart", "ranking", "target gap", "distribution"],
      "avoid_when": "the values are not comparable"
    },
    {
      "id": "matrix",
      "encodes": "two-dimensional classification or exact comparison",
      "reading_flow": "headers to cells to highlighted intersection",
      "use_for": ["options", "risks", "decision table", "portfolio map"],
      "avoid_when": "a sequence or hierarchy is the real relationship"
    },
    {
      "id": "stack",
      "encodes": "hierarchy, composition, or layers",
      "reading_flow": "top-down, bottom-up, or outside-in as labeled",
      "use_for": ["hierarchy", "system layers", "priority pyramid"],
      "avoid_when": "layer position has no meaning"
    },
    {
      "id": "network",
      "encodes": "many-to-many relationships, ecosystem, or feedback",
      "reading_flow": "anchor node to labeled connections",
      "use_for": ["ecosystem", "stakeholders", "system topology"],
      "avoid_when": "a linear process explains the idea more clearly"
    },
    {
      "id": "mosaic",
      "encodes": "a curated collection with one hierarchy",
      "reading_flow": "dominant item to supporting items",
      "use_for": ["portfolio", "gallery", "contact sheet", "case evidence"],
      "avoid_when": "all tiles would become equally small"
    },
    {
      "id": "field",
      "encodes": "atmosphere, context, or full-frame proof",
      "reading_flow": "image or scene first, restrained overlay second",
      "use_for": ["section shift", "photography", "product hero", "location"],
      "avoid_when": "precise labels or dense evidence dominate"
    },
    {
      "id": "frame",
      "encodes": "one inspected artifact inside an explanatory frame",
      "reading_flow": "artifact to annotation to implication",
      "use_for": ["dashboard", "document", "UI", "research figure"],
      "avoid_when": "the artifact remains unreadably small"
    }
  ],
  "layouts": [
    {
      "id": "hero-decision",
      "topology": "stage",
      "roles": ["cover", "closing"],
      "relationships": ["decision", "central promise"],
      "required_slots": ["headline"],
      "optional_slots": ["kicker", "subhead", "metric-strip", "hero-media"],
      "media_slots": 1,
      "density": ["speaking", "hybrid"],
      "tones": ["dark", "light", "accent", "media"],
      "max_items": 4,
      "fidelity": "native-preferred",
      "guardrails": ["one dominant headline", "no agenda list", "keep metadata subordinate"]
    },
    {
      "id": "statement-monument",
      "topology": "stage",
      "roles": ["section", "content", "pause"],
      "relationships": ["thesis", "insight", "quote"],
      "required_slots": ["headline"],
      "optional_slots": ["source", "support-line", "ghost-marker"],
      "media_slots": 0,
      "density": ["speaking"],
      "tones": ["dark", "light", "accent"],
      "max_items": 2,
      "fidelity": "native",
      "guardrails": ["do not turn a weak claim into a slogan", "support copy under 28 words"]
    },
    {
      "id": "claim-proof-split",
      "topology": "split",
      "roles": ["content"],
      "relationships": ["claim and evidence", "context and implication"],
      "required_slots": ["headline", "proof"],
      "optional_slots": ["support-copy", "annotation", "source"],
      "media_slots": 1,
      "density": ["speaking", "hybrid", "reading"],
      "tones": ["dark", "light", "media"],
      "max_items": 3,
      "fidelity": "native-or-mixed",
      "guardrails": ["proof occupies at least 40 percent of the stage", "do not repeat the headline in body copy"]
    },
    {
      "id": "before-after-delta",
      "topology": "split",
      "roles": ["content"],
      "relationships": ["before and after", "option contrast", "current and target"],
      "required_slots": ["headline", "left-state", "right-state"],
      "optional_slots": ["delta", "source", "decision-note"],
      "media_slots": 2,
      "density": ["hybrid", "reading"],
      "tones": ["light", "dark"],
      "max_items": 6,
      "fidelity": "native-preferred",
      "guardrails": ["use a shared comparison basis", "highlight the meaningful difference, not both sides equally"]
    },
    {
      "id": "metric-monument",
      "topology": "stage",
      "roles": ["content"],
      "relationships": ["single decisive metric", "scale", "target"],
      "required_slots": ["headline", "metric"],
      "optional_slots": ["unit", "context", "mini-comparators", "source"],
      "media_slots": 0,
      "density": ["speaking", "hybrid"],
      "tones": ["light", "dark", "accent"],
      "max_items": 4,
      "fidelity": "native",
      "guardrails": ["give the number a comparison frame", "never present an unlabeled vanity metric"]
    },
    {
      "id": "ranked-evidence-axis",
      "topology": "axis",
      "roles": ["content"],
      "relationships": ["ranking", "contribution", "variance"],
      "required_slots": ["headline", "chart"],
      "optional_slots": ["annotation", "source", "takeaway"],
      "media_slots": 0,
      "density": ["hybrid", "reading"],
      "tones": ["light", "dark"],
      "max_items": 8,
      "fidelity": "native",
      "guardrails": ["sort when rank is the question", "direct-label values", "highlight only claim-bearing series"]
    },
    {
      "id": "trend-axis",
      "topology": "axis",
      "roles": ["content"],
      "relationships": ["time series", "trajectory", "forecast versus actual"],
      "required_slots": ["headline", "chart"],
      "optional_slots": ["milestone", "annotation", "source"],
      "media_slots": 0,
      "density": ["hybrid", "reading"],
      "tones": ["light", "dark"],
      "max_items": 5,
      "fidelity": "native",
      "guardrails": ["label time and units", "distinguish actual, scenario, and forecast"]
    },
    {
      "id": "process-spine",
      "topology": "spine",
      "roles": ["content"],
      "relationships": ["process", "journey", "causal sequence"],
      "required_slots": ["headline", "steps"],
      "optional_slots": ["owners", "duration", "gates", "source"],
      "media_slots": 0,
      "density": ["speaking", "hybrid"],
      "tones": ["light", "dark"],
      "max_items": 6,
      "fidelity": "native",
      "guardrails": ["make direction explicit", "vary step scale only when importance differs"]
    },
    {
      "id": "timeline-gates",
      "topology": "spine",
      "roles": ["content", "closing"],
      "relationships": ["timeline", "roadmap", "stage gates"],
      "required_slots": ["headline", "phases"],
      "optional_slots": ["dates", "gates", "owner", "decision"],
      "media_slots": 0,
      "density": ["hybrid", "reading"],
      "tones": ["light", "dark"],
      "max_items": 6,
      "fidelity": "native",
      "guardrails": ["time position must be meaningful", "separate activity from approval gates"]
    },
    {
      "id": "decision-matrix",
      "topology": "matrix",
      "roles": ["content", "closing"],
      "relationships": ["option comparison", "criteria", "recommendation"],
      "required_slots": ["headline", "options", "criteria"],
      "optional_slots": ["recommendation", "source", "trade-off"],
      "media_slots": 0,
      "density": ["hybrid", "reading"],
      "tones": ["light", "dark"],
      "max_items": 12,
      "fidelity": "native",
      "guardrails": ["do not imply equal weights unless true", "make the recommendation visible"]
    },
    {
      "id": "risk-control-map",
      "topology": "matrix",
      "roles": ["content"],
      "relationships": ["risk and mitigation", "issue and owner", "objection and answer"],
      "required_slots": ["headline", "risks", "controls"],
      "optional_slots": ["owner", "trigger", "residual-risk"],
      "media_slots": 0,
      "density": ["hybrid", "reading"],
      "tones": ["light", "dark"],
      "max_items": 8,
      "fidelity": "native",
      "guardrails": ["pair every material risk with a control", "avoid decorative heatmaps without thresholds"]
    },
    {
      "id": "layer-stack",
      "topology": "stack",
      "roles": ["content"],
      "relationships": ["hierarchy", "architecture", "priority levels"],
      "required_slots": ["headline", "layers"],
      "optional_slots": ["direction-label", "annotation", "boundary"],
      "media_slots": 0,
      "density": ["speaking", "hybrid"],
      "tones": ["light", "dark"],
      "max_items": 6,
      "fidelity": "native",
      "guardrails": ["spatial order must encode real hierarchy", "avoid pyramids when size has no quantitative meaning"]
    },
    {
      "id": "relationship-map",
      "topology": "network",
      "roles": ["content"],
      "relationships": ["ecosystem", "stakeholder network", "system dependencies"],
      "required_slots": ["headline", "nodes", "connections"],
      "optional_slots": ["legend", "boundary", "source"],
      "media_slots": 0,
      "density": ["hybrid", "reading"],
      "tones": ["light", "dark"],
      "max_items": 10,
      "fidelity": "native-or-vector",
      "guardrails": ["use a graph layout engine for complex networks", "label edge meaning", "do not cross labels"]
    },
    {
      "id": "portfolio-mosaic",
      "topology": "mosaic",
      "roles": ["content"],
      "relationships": ["selected work", "evidence collection", "range and focus"],
      "required_slots": ["headline", "dominant-media"],
      "optional_slots": ["supporting-media", "captions", "project-label"],
      "media_slots": 5,
      "density": ["speaking", "hybrid"],
      "tones": ["light", "dark", "media"],
      "max_items": 5,
      "fidelity": "mixed",
      "guardrails": ["one work item must dominate", "do not shrink every image to thumbnail size", "caption contribution or result"]
    },
    {
      "id": "editorial-media-field",
      "topology": "field",
      "roles": ["cover", "section", "content", "pause"],
      "relationships": ["context", "tone", "human impact", "product presence"],
      "required_slots": ["media"],
      "optional_slots": ["headline", "caption", "kicker"],
      "media_slots": 1,
      "density": ["speaking"],
      "tones": ["media", "dark", "light"],
      "max_items": 2,
      "fidelity": "mixed",
      "guardrails": ["image must prove, explain, locate, humanize, or establish necessary tone", "protect focal region", "use a text contrast mask"]
    },
    {
      "id": "artifact-proof-frame",
      "topology": "frame",
      "roles": ["content"],
      "relationships": ["artifact and implication", "UI proof", "document evidence"],
      "required_slots": ["headline", "artifact"],
      "optional_slots": ["annotation", "caption", "source", "zoom-detail"],
      "media_slots": 2,
      "density": ["hybrid", "reading"],
      "tones": ["light", "dark"],
      "max_items": 4,
      "fidelity": "mixed",
      "guardrails": ["artifact labels remain readable", "annotate with native text", "use a zoom detail instead of a tiny full screenshot"]
    },
    {
      "id": "decision-lock",
      "topology": "stage",
      "roles": ["closing"],
      "relationships": ["decision", "commitment", "next action"],
      "required_slots": ["headline", "action"],
      "optional_slots": ["owner", "date", "budget", "conditions"],
      "media_slots": 0,
      "density": ["speaking", "hybrid"],
      "tones": ["dark", "light", "accent"],
      "max_items": 5,
      "fidelity": "native",
      "guardrails": ["state the ask as an executable action", "show owner and timing when relevant", "do not close with generic thanks"]
    },
    {
      "id": "appendix-detail",
      "topology": "matrix",
      "roles": ["appendix"],
      "relationships": ["lookup", "method", "detail"],
      "required_slots": ["headline", "detail"],
      "optional_slots": ["source", "method-note", "definitions"],
      "media_slots": 1,
      "density": ["reading"],
      "tones": ["light", "dark"],
      "max_items": 16,
      "fidelity": "native-preferred",
      "guardrails": ["retain readable type", "do not pull appendix density into the main story"]
    }
  ]
}
