{
  "name": "bread-stage",
  "private": true,
  "version": "0.1.0",
  "description": "パンが、店先に届くまで。",
  "author": "Studio Yebisu / 架空企画",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && node scripts/check-offline.mjs dist deck",
    "present": "npm run build && vite preview --host 127.0.0.1 --port 4173 --strictPort --open",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "verify": "node scripts/verify.mjs dist artifacts/verify",
    "shot": "node scripts/shot.mjs",
    "upgrade": "node scripts/upgrade.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
