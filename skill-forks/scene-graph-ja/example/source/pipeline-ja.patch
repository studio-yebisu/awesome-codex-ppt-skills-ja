+def _set_japanese_font(run, name):
+    """Local Japanese font mapping; original factories/restyling remain the callers."""
+    run.font.name = name
+    rpr = run._r.get_or_add_rPr()
+    rpr.set('lang', 'ja-JP')
+    for tag in ('a:ea', 'a:cs'):
+        element = rpr.find(qn(tag))
+        if element is None:
+            element = etree.SubElement(rpr, qn(tag))
+        element.set('typeface', name)
+
 
