{
  "repository": "gonta223/japanese-corporate-pptx-skill",
  "execution_type": "instruction_skill_native_template",
  "summary_ja": "数値に解釈を添え、担当間の受け渡しと判断条件をnative PPTXへ組み立てる。原典は制作指示と15型テンプレート。",
  "requirements": [
    "読者・判断と、数値・単位・期間・出所、主体・条件の記録。",
    "native PPTXを調査・編集・描画・再読込できるホスト。作例再生成はPython/python-pptx/lxml/Pillow、Windows PowerPoint、PDFium。"
  ],
  "steps": [
    "原典6参照と15型を確認し、参照優先順に実画像を調べstyle ledgerを作る。",
    "頁ごとの主張、主体、入出力、判断条件、出所をそろえる。",
    "関係に合う型を選び、native図形・線・チャート・表へ編集する。",
    "全頁の互換描画・overflow・元データ・package・再読込を検査し、原典JTCの独立受理を得る。"
  ],
  "commands": [
    "cd example",
    "python source/rebuild.py",
    "powershell -NoProfile -File source/render_powerpoint.ps1 -PresentationPath deck.pptx -OutputDirectory render",
    "python source/render_pdf_previews.py render",
    "python source/check_native.py",
    "powershell -NoProfile -File source/check_overflow.ps1",
    "powershell -NoProfile -File source/check_edit_reopen.ps1"
  ],
