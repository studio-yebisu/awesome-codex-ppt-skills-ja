{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scrolline-v2 state/runs.jsonl 한 줄 (plan/CONTRACTS.md C18). run은 이벤트 줄: 같은 run_id의 마지막 줄이 현재 상태",
  "oneOf": [
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/feedback" }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha" } },
    "time": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "run": {
      "type": "object",
      "required": ["run_id", "parent_run_id", "root_run_id", "run_type", "name", "status", "started_at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "run" },
        "run_id": { "type": "string", "minLength": 1 },
        "parent_run_id": { "type": ["string", "null"] },
        "root_run_id": { "type": "string", "minLength": 1 },
        "trace": { "type": "string" },
        "run_type": { "enum": ["wave", "research", "design", "build", "judge", "render", "repair"] },
        "name": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "hat": { "enum": ["feature", "refactor", "none"] },
        "target": { "type": "object", "required": ["kind", "id"], "additionalProperties": false,
          "properties": { "kind": { "enum": ["deck", "move", "engine", "concept", "site", "research"] }, "id": { "type": "string", "minLength": 1 } } },
        "inputs": { "type": "object", "additionalProperties": false,
          "properties": { "brief": { "type": "string" }, "brief_sha256": { "$ref": "#/$defs/sha" }, "files": { "$ref": "#/$defs/files" } } },
        "outputs": { "type": "object", "additionalProperties": false,
          "properties": { "files": { "$ref": "#/$defs/files" }, "commit": { "type": ["string", "null"] } } },
        "status": { "enum": ["queued", "running", "success", "error", "cancelled"] },
        "error": { "type": ["string", "null"] },
        "started_at": { "$ref": "#/$defs/time" },
        "ended_at": { "$ref": "#/$defs/time" },
        "tokens": { "type": ["object", "null"], "additionalProperties": false,
          "properties": { "input": { "type": "integer", "minimum": 0 }, "output": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "feedback": {
      "type": "object",
      "required": ["kind", "feedback_id", "run_id", "key", "score", "by_run_id", "time"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "feedback" },
        "feedback_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "key": { "enum": ["wow", "tech", "content", "diversity", "a11y"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "value": { "type": "string" },
        "comment": { "type": "string" },
        "by_run_id": { "type": "string", "minLength": 1 },
        "time": { "$ref": "#/$defs/time" }
      }
    }
  }
}
