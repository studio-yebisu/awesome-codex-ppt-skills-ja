  "start": {
    "heading": {
      "ko": "빠른 시작",
      "en": "Quick start"
    },
    "body": {
      "ko": "Node 22 이상. 컨셉 하나를 골라 덱을 만들고 dev 서버에서 scroll로 확인합니다.",
      "en": "Node 22 or later. Pick a concept, create a deck, and scroll through it on the dev server."
    },
    "lines": [
      "git clone -b v2 https://github.com/gongnyang/awesome-html-scrolline-deck scrolline",
      "cd scrolline && npm install",
      "npm run deck -- new my-deck --concept rail && npm run dev"
    ],
    "after": {
      "ko": "브라우저에서 /decks/my-deck/ 를 엽니다. MP4가 필요하면 npm run export -- my-deck",
      "en": "Open /decks/my-deck/ in the browser. For an MP4, run npm run export -- my-deck"
    },
