{
  "id": "rail",
  "name": "가로 레일 연표",
  "axis": "x",
  "camera": {
    "mode": "rail",
    "perspective": 1800
  },
  "timing": {
    "unit": 0.5,
    "hold": 0.5,
    "overlap": 0.15
  },
  "eases": {
    "in": "power2.in",
    "out": "expo.out",
    "inout": "power2.inOut",
    "scrub": "none",
    "travel": "power3.inOut",
    "arrive": "expo.out",
    "settle": "power3.out"
  },
  "beats": {
    "allow": [
      "chronology",
      "text",
      "number",
      "quote",
      "video",
      "photo"
    ]
  },
  "moves": {
    "allow": [
      "rail-advance",
      "era-shift",
      "counter-handoff",
      "rail-lift",
      "rail-drop",
      "fold-to-rail",
      "rail-split-open",
      "rail-compress",
      "rail-draw",
      "rail-surface",
      "rail-settle",
      "mask-word-in",
      "line-mask-rise",
      "count-roll",
      "video-scrub",
      "frame-to-figure",
      "engine:fade-in",
      "engine:fade-out",
      "engine:crossfade",
      "engine:none",
      "text-mask-dive"
    ],
    "signature": [
      "rail-advance",
      "era-shift",
      "counter-handoff"
    ]
  },
  "defaults": {
    "enter": "line-mask-rise",
    "exit": "engine:fade-out",
    "byType": {
      "chronology": {
