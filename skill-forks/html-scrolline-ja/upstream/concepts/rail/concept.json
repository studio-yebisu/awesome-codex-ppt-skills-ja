  "tokens": {
    "nowX": 0.375,
    "railY": 0.66,
    "monthPx": 64,
    "overviewMonthPx": 14,
    "ghostParallax": 1,
    "blurMax": 4,
    "trailOpacity": 0.32,
    "minorScale": 0.62,
    "stemMax": 240,
    "liftRise": 0.12,
    "stagger": 0.06,
    "depthNear": 1.0,
    "depthFar": 0.35,
    "settleTilt": 9,
    "settleScale": 1.15,
    "crossfadeMax": 0.15
