      },
      "number": {
        "enter": "count-roll"
      },
      "video": {
        "enter": "mask-word-in"
      },
      "photo": {
        "enter": "mask-word-in"
      }
    }
  },
  "slots": {
    "center": {
      "x": 0.5,
      "y": 0.42
    },
    "full": {
      "x": 0.5,
      "y": 0.5
    },
    "left": {
      "x": 0.33,
      "y": 0.42
    },
    "lower-third": {
      "x": 0.0625,
      "y": 0.8
    }
