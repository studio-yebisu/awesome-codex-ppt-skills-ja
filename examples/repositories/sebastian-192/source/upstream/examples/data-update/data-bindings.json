    },
    {
      "document": "page_spec",
      "pointer": "/slides/1/elements/1/data/series/0/values/0",
      "value": "north_before"
    },
    {
      "document": "page_spec",
      "pointer": "/slides/1/elements/1/data/series/0/values/1",
      "value": "east_before"
    },
    {
      "document": "page_spec",
      "pointer": "/slides/1/elements/1/data/series/1/values/0",
      "value": "north_after"
    },
    {
      "document": "page_spec",
      "pointer": "/slides/1/elements/1/data/series/1/values/1",
      "value": "east_after"
    },
    {
      "document": "scene",
