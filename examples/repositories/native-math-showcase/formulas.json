[
  {
    "id": "mean",
    "latex": "\\bar{x}=\\frac{1}{n}\\sum_{i=1}^{n}x_i",
    "mode": "display",
    "render": "omml"
  },
  {
    "id": "mean-a",
    "latex": "\\bar{x}_A=\\frac{4+5+6}{3}=5",
    "mode": "display",
    "render": "omml"
  },
  {
    "id": "mean-b",
    "latex": "\\bar{x}_B=\\frac{0+5+10}{3}=5",
    "mode": "display",
    "render": "omml"
  },
  {
    "id": "variance",
    "latex": "\\sigma^2=\\frac{1}{n}\\sum_{i=1}^{n}(x_i-\\bar{x})^2",
    "mode": "display",
    "render": "omml"
  },
  {
    "id": "var-a",
    "latex": "\\sigma_A^2=\\frac{1+0+1}{3}=\\frac{2}{3}",
    "mode": "display",
    "render": "omml"
  },
  {
    "id": "var-b",
    "latex": "\\sigma_B^2=\\frac{25+0+25}{3}=\\frac{50}{3}",
    "mode": "display",
    "render": "omml"
  },
  {
    "id": "sd",
    "latex": "\\sigma=\\sqrt{\\sigma^2}",
    "mode": "display",
    "render": "omml"
  },
  {
    "id": "sd-a",
    "latex": "\\sigma_A=\\sqrt{\\frac{2}{3}}\\approx 0.82",
    "mode": "display",
    "render": "omml"
  },
  {
    "id": "sd-b",
    "latex": "\\sigma_B=\\sqrt{\\frac{50}{3}}\\approx 4.08",
    "mode": "display",
    "render": "omml"
  }
]
