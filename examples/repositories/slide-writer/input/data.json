    {
      "title": "話す順番を決めておく",
      "html": "<section class=\"slide slide-white\" id=\"slide-2\"><div class=\"slide-header center-stack\"><span class=\"header-mark\"></span><h2 class=\"header-title\">話す順番を決めておく</h2><p class=\"header-sub\">この資料でそろえる、四つのこと</p></div><div class=\"slide-body\" style=\"justify-content:center\"><div style=\"width:min(100%,var(--deck-safe-width));margin:0 auto\"><div style=\"display:flex;flex-direction:column;gap:var(--element-gap);width:80%;margin:auto\"><div class=\"agenda-item reveal\"><span class=\"agenda-num\">01</span><span class=\"agenda-text\">議題を分ける</span><span class=\"agenda-tag\">3ページ</span></div><div class=\"agenda-item reveal\"><span class=\"agenda-num\">02</span><span class=\"agenda-text\">順番を決める</span><span class=\"agenda-tag\">5ページ</span></div><div class=\"agenda-item reveal\"><span class=\"agenda-num\">03</span><span class=\"agenda-text\">判断の伝え方</span><span class=\"agenda-tag\">6ページ</span></div><div class=\"agenda-item reveal\"><span class=\"agenda-num\">04</span><span class=\"agenda-text\">続け方を考える</span><span class=\"agenda-tag\">7ページ</span></div></div></div></div></section>",
